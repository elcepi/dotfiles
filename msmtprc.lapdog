# A system wide configuration file is optional.
account default

# The place where the mail goes. The actual machine name is required
# no MX records are consulted. Both port 465 or 587 should be acceptable
# See also https://support.google.com/mail/answer/78799
host smtp.gmail.com
port 587

# Construct envelope-from addresses of the form "user@oursite.example".
auto_from off
allow_from_override off
set_from_header on
from jhespinosa+cron@gmail.com

# Dispatch mails according to /etc/aliases
aliases /etc/aliases

# Use TLS.
tls on
tls_starttls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt


# Authenticate to GMail
#
# 2fa needs to be enaded
# App Passwords can be generated on https://myaccount.google.com/apppasswords

auth on
user jhespinosa@gmail.com
#passwordeval  /usr/bin/secret-tool lookup  mail gmail #secre-tool needs a GUI
passwordeval /usr/bin/cat /home/jose/.msmtprc-password
