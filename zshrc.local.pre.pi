zstyle ':omz:update' mode auto

unsetopt share_history
setopt hist_ignore_all_dups

ZSH_CUSTOM=${HOME}/.dotfiles/custom

HISTSIZE=1000000
ignore_commands=(lsrm lshrea ignore-.backup)

plugins=(
  aliases
  common-aliases
  history
  )

ZSH_THEME="minimal"

alias test_boinc='sudo boinccmd --get_tasks; sudo boinccmd --get_state'

